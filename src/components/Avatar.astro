---
interface Props {
  name: string;
  github?: string;
  size?: number;
}
const { name, github, size = 64 } = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]!.toUpperCase())
  .join('');
let hash = 0;
for (const ch of name) hash = (hash * 31 + ch.charCodeAt(0)) % 360;
const hue = hash;
---

<span class="avatar" style={`--size:${size}px; --hue:${hue}`}>
  <span class="initials" aria-hidden="true">{initials}</span>
  {
    github && (
      <img
        src={`https://github.com/${encodeURIComponent(github)}.png?size=${size * 2}`}
        alt={`${name}'s GitHub avatar`}
        width={size}
        height={size}
        loading="lazy"
        onerror="this.remove()"
      />
    )
  }
</span>

<style>
  .avatar {
    position: relative;
    display: inline-block;
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: hsl(var(--hue) 55% 45%);
  }
  .initials,
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .initials {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 600;
    font-size: calc(var(--size) * 0.38);
  }
  img {
    object-fit: cover;
    background: var(--canvas);
  }
</style>
